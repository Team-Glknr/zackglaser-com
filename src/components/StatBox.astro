---
// Mono label over a serif value. Build-log rollups only.
// An unknown value renders as "—" — never an estimate.
interface Props {
  label: string;
  value: string | number;
  size?: "md" | "lg";  // lg = project rollup 4-up grid, md = chapter page row
  class?: string;
}
const { label, value, size = "md", class: className } = Astro.props;
---

<div class={["stat-box", `s-${size}`, className].filter(Boolean).join(" ")}>
  <div class="stat-label">{label}</div>
  <div class="stat-val">{value}</div>
</div>

<style>
  .stat-box {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .s-lg { padding: var(--space-4); }
  .s-md { padding: 10px 16px; min-width: 100px; }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .s-lg .stat-label { margin-bottom: 6px; }
  .s-md .stat-label { margin-bottom: 4px; }
  .stat-val {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-ink);
  }
  .s-lg .stat-val { font-size: 20px; }
  .s-md .stat-val { font-size: 16px; }
</style>
