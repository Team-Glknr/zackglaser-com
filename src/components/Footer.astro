---
// Structure/tokens ported from docs/design-system/Site Nav & Footer.dc.html.
// "Elsewhere" column: real destinations throughout — the Lawyerist Podcast,
// the site's own /rss.xml feed, and LinkedIn/GitHub in place of a standalone
// email link (the /speaking booking form already covers direct inquiries).
// Newsletter form is wired to Buttondown.
import { pillars } from "../lib/pillars";
import SectionLabel from "./SectionLabel.astro";
import TextInput from "./TextInput.astro";
import BracketButton from "./BracketButton.astro";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-cols">
    <div class="footer-col">
      <SectionLabel size={11} class="footer-col-label">pillars</SectionLabel>
      {
        pillars.map((p) => (
          <a href={p.href} class="footer-link" style={`--hover-color:var(--pillar-${p.id})`}>
            {p.label}
          </a>
        ))
      }
    </div>
    <div class="footer-col">
      <SectionLabel size={11} class="footer-col-label">site</SectionLabel>
      <a href="/legal-tech/speaking" class="footer-link">speaking</a>
      <a href="/about" class="footer-link">about</a>
      <a href="/now" class="footer-link">now</a>
      <a href="/newsletter" class="footer-link">knolling archive</a>
    </div>
    <div class="footer-col">
      <SectionLabel size={11} class="footer-col-label">elsewhere</SectionLabel>
      <a href="https://lawyerist.com/podcast" target="_blank" rel="noopener" class="footer-link">lawyerist podcast ↗</a>
      <a href="/rss.xml" class="footer-link">rss</a>
      <a href="https://www.linkedin.com/in/zackglaser/" target="_blank" rel="noopener" class="footer-link">linkedin ↗</a>
      <a href="https://github.com/thirdth" target="_blank" rel="noopener" class="footer-link">github ↗</a>
    </div>
    <div class="footer-col footer-newsletter-col">
      <SectionLabel size={11} class="footer-col-label">knolling</SectionLabel>
      <form
        action="https://buttondown.com/api/emails/embed-subscribe/knolling"
        method="post"
        class="embeddable-buttondown-form footer-newsletter-row"
      >
        <label for="bd-email-footer" class="sr-only">Enter your email</label>
        <TextInput type="email" name="email" id="bd-email-footer" required size="sm" placeholder="you@email.com" />
        <input type="hidden" name="tag" value="footer" />
        <BracketButton type="submit" size="sm">go</BracketButton>
      </form>
      <a href="https://buttondown.com/refer/knolling" target="_blank" rel="noopener" class="footer-powered-by">
        Powered by Buttondown.
      </a>
    </div>
  </div>
  <div class="footer-meta-row">
    <p class="footer-meta-text">
      This site lives in a public GitHub repo —{" "}
      <a href="https://github.com/Team-Glknr/zackglaser-com" target="_blank" rel="noopener" class="inline-link">read the source ↗</a>{" "}
      or{" "}
      <a href="https://github.com/Team-Glknr/zackglaser-com/commits/main" target="_blank" rel="noopener" class="inline-link">see every change ever made to it ↗</a>.{" "}
      <a href="/how-this-site-is-made" class="inline-link">How this site is made →</a>
    </p>
  </div>
  <div class="footer-bottom">
    <a href="/" class="footer-wordmark">
      <span class="wordmark-zack">zack</span><span class="wordmark-glaser">glaser</span>
    </a>
    <div class="footer-copy">© {year} zack glaser — legal tech advisor, runner, tinkerer</div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  :global(.footer-col-label) {
    margin-bottom: var(--space-1);
  }
  .footer-link {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .footer-link:hover {
    color: var(--hover-color, var(--color-ink-soft));
  }
  .footer-newsletter-row {
    display: flex;
    gap: var(--space-2);
  }
  .footer-powered-by {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-decoration: none;
    width: fit-content;
  }
  .footer-powered-by:hover {
    color: var(--color-ink);
  }
  .footer-meta-row {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }
  .footer-meta-text {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 640px;
  }
  .footer-meta-text .inline-link {
    color: var(--color-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  .footer-meta-text .inline-link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-5);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer-wordmark {
    font-size: 16px;
    text-decoration: none;
  }
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
  }

  @media (max-width: 720px) {
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
