---
// GitHub on-ramp rung 2 — docs/03-github-onramp.md §5.2. Mounted in
// src/pages/[...id].astro with the real repo-id/category-id from the
// giscus app install + "Comments" Discussion category on thirdth/zackglaser-com.
// Zero client JS shipped by us; the script below is giscus's own, lazy-loaded.
// Intro messaging now lives in GithubOnramp.astro's "react" step, which
// anchor-links to this section's id — keep the id in sync with that href.
interface Props {
  repoId: string;
  categoryId: string;
}
const { repoId, categoryId } = Astro.props;
---

<section class="comments" id="comments">
  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo="thirdth/zackglaser-com"
    data-repo-id={repoId}
    data-category="Comments"
    data-category-id={categoryId}
    data-mapping="pathname"
    data-strict="1"
    data-reactions-enabled="1"
    data-input-position="top"
    data-theme="preferred_color_scheme"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<style>
  .comments {
    margin-bottom: var(--space-8);
  }
</style>
