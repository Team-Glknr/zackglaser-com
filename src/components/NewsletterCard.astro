---
// Posts to Buttondown's HTML-form embed endpoint — exact markup confirmed
// against the real account's own generated snippet, not just the generic docs.
// `tag` (optional) records where the signup came from, for the pillar-crossover
// metric in brief §10.
import TextInput from "./TextInput.astro";
import BracketButton from "./BracketButton.astro";
interface Props {
  eyebrow?: string;
  tag?: string;
}
const { eyebrow = "knolling — the newsletter", tag } = Astro.props;
---

<div class="newsletter-card">
  <div class="newsletter-eyebrow">{eyebrow}</div>
  <div class="newsletter-headline">One thing, taken apart. Every week-ish.</div>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/knolling"
    method="post"
    class="embeddable-buttondown-form newsletter-form-row"
  >
    <label for="bd-email-card" class="sr-only">Enter your email</label>
    <TextInput type="email" name="email" id="bd-email-card" required size="md" placeholder="you@email.com" />
    {tag && <input type="hidden" name="tag" value={tag} />}
    <BracketButton type="submit" size="sm">subscribe</BracketButton>
  </form>
  <a href="https://buttondown.com/refer/knolling" target="_blank" rel="noopener" class="powered-by">
    Powered by Buttondown.
  </a>
</div>

<style>
  .newsletter-card {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-9);
  }
  .newsletter-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .newsletter-headline {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .newsletter-form-row {
    display: flex;
    gap: var(--space-3);
    max-width: 420px;
  }
  .powered-by {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-decoration: none;
    width: fit-content;
  }
  .powered-by:hover {
    color: var(--color-ink);
  }
</style>
