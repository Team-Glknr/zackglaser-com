---
// Structure/tokens ported from docs/design-system/Site Nav & Footer.dc.html
// and Mobile Nav.dc.html. Dropdown and mobile overlay use native
// <details>/checkbox toggles — zero client JS, per brief §7 design direction.
import { pillars } from "../lib/pillars";
---

<nav class="site-nav">
  <a href="/" class="wordmark">
    <svg class="nav-mark" viewBox="-24 -24 80 80" width="44" height="44" aria-hidden="true">
      <g class="mark-part p1"><rect x="1" y="1" width="13" height="13" rx="1.5" class="mark-ink" /></g>
      <g class="mark-part p2"><rect x="18" y="1" width="13" height="13" rx="1.5" class="mark-ink" /></g>
      <g class="mark-part p3"><rect x="1" y="18" width="13" height="13" rx="1.5" class="mark-ink" /></g>
      <g class="mark-part p4"><rect x="18" y="18" width="13" height="13" rx="1.5" class="mark-accent" /></g>
    </svg>
    <span class="wordmark-zack">zack</span><span class="wordmark-glaser">glaser</span>
  </a>

  <details class="nav-pillars">
    <summary class="nav-link">pillars</summary>
    <div class="pillars-dropdown">
      {
        pillars.map((p) => (
          <a href={p.href} class="pillar-item">
            <span class="pillar-dot" style={`background:var(--pillar-${p.id})`} />
            {p.label}
          </a>
        ))
      }
    </div>
  </details>

  <a href="/legal-tech/speaking" class="nav-link">speaking</a>
  <a href="/newsletter" class="nav-link">knolling</a>
  <a href="/about" class="nav-link">about</a>
  <a href="/newsletter" class="nav-subscribe">[ subscribe ]</a>

  <input type="checkbox" id="mobile-nav-toggle" class="mobile-nav-toggle" />
  <label for="mobile-nav-toggle" class="mobile-menu-btn" aria-label="Toggle menu">
    <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M4,7 H20 M4,12 H20 M4,17 H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
    </svg>
    <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none">
      <path d="M6,6 L18,18 M18,6 L6,18" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
    </svg>
  </label>

  <div class="mobile-overlay">
    <div class="overlay-section-label">pillars</div>
    {
      pillars.map((p) => (
        <a href={p.href} class="overlay-row">
          <span class="pillar-dot pillar-dot-lg" style={`background:var(--pillar-${p.id})`} />
          {p.label}
        </a>
      ))
    }
    <div class="overlay-divider"></div>
    <a href="/legal-tech/speaking" class="overlay-row">speaking</a>
    <a href="/newsletter" class="overlay-row">knolling</a>
    <a href="/about" class="overlay-row">about</a>
    <a href="/newsletter" class="overlay-subscribe">[ subscribe ]</a>
  </div>
</nav>
<hr class="site-nav-rule" />

<style>
  .site-nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 36px;
    padding: 24px 32px 20px;
    background: none;
    border: none;
    border-radius: 0;
  }
  .site-nav-rule {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 0;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 22px;
    flex-shrink: 0;
    margin-right: var(--space-2);
    text-decoration: none;
  }

  /* Motion logo — docs/design-system/motion/knolling-motion-preview.html.
     Plays once on load, settles knolled. Reduced motion is handled globally
     (theme.css) — animation is disabled, parts simply render already-assembled. */
  .nav-mark {
    overflow: visible;
    flex-shrink: 0;
  }
  .mark-ink {
    fill: var(--color-ink);
  }
  .mark-accent {
    fill: var(--pillar-workshop);
  }
  .mark-part {
    transform-box: fill-box;
    transform-origin: center;
    animation-duration: 700ms;
    animation-timing-function: cubic-bezier(0.22, 0.61, 0.32, 1);
    animation-iteration-count: 1;
    animation-fill-mode: forwards;
  }
  .p1 {
    animation-name: knoll-p1;
  }
  .p2 {
    animation-name: knoll-p2;
    animation-delay: 0.09s;
  }
  .p3 {
    animation-name: knoll-p3;
    animation-delay: 0.18s;
  }
  .p4 {
    animation-name: knoll-p4;
    animation-delay: 0.27s;
  }
  @keyframes knoll-p1 {
    0% {
      transform: translate(-18px, -22px) rotate(-10deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes knoll-p2 {
    0% {
      transform: translate(20px, -14px) rotate(7deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes knoll-p3 {
    0% {
      transform: translate(-16px, 18px) rotate(11deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes knoll-p4 {
    0% {
      transform: translate(18px, 20px) rotate(-8deg);
    }
    100% {
      transform: none;
    }
  }

  .wordmark-zack {
    font-family: var(--font-serif-logo);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .wordmark-glaser {
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .nav-link {
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  .nav-link::-webkit-details-marker {
    display: none;
  }
  .nav-link:hover {
    border-bottom-color: var(--color-ink);
  }

  .nav-pillars {
    position: relative;
  }
  .pillars-dropdown {
    position: absolute;
    top: 34px;
    left: 0;
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-elevation);
    padding: 6px;
    display: flex;
    flex-direction: column;
    min-width: 160px;
    z-index: 2;
  }
  .pillar-item {
    display: flex;
    align-items: center;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 10px;
    border-radius: var(--radius-input);
  }
  .pillar-item:hover {
    background: var(--color-paper);
  }
  .pillar-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .nav-subscribe {
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 8px 14px;
    border-radius: var(--radius-input);
    flex-shrink: 0;
  }
  .nav-subscribe:hover {
    border-color: var(--color-ink);
  }

  .mobile-nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .mobile-menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    margin-left: auto;
    color: var(--color-ink);
  }
  .icon-close {
    display: none;
  }
  .mobile-nav-toggle:checked ~ .mobile-menu-btn .icon-menu {
    display: none;
  }
  .mobile-nav-toggle:checked ~ .mobile-menu-btn .icon-close {
    display: block;
  }

  .mobile-overlay {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-elevation);
    padding: var(--space-5);
    flex-direction: column;
    gap: 2px;
    z-index: 3;
  }
  .mobile-nav-toggle:checked ~ .mobile-overlay {
    display: flex;
  }
  .overlay-section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 10px 4px 6px;
  }
  .overlay-divider {
    height: 1px;
    background: var(--color-line);
    margin: 12px 0;
  }
  .overlay-row {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0 4px;
  }
  .pillar-dot-lg {
    width: 9px;
    height: 9px;
    margin-right: 12px;
  }
  .overlay-subscribe {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    background: var(--color-ink);
    color: var(--color-paper);
    text-decoration: none;
    border-radius: var(--radius-card);
    font-family: var(--font-mono);
    font-size: 15px;
  }

  @media (max-width: 900px) {
    .site-nav {
      gap: var(--space-3);
      padding: 14px 20px;
    }
    .nav-pillars,
    .site-nav > .nav-link,
    .nav-subscribe {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
