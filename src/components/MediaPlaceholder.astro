---
// Visual "asset pending" placeholder — distinct from EmptyState, which
// signals a genuinely empty collection. This signals real content is
// planned (a headshot, a clip, a testimonial) but isn't shot, cut, or
// collected yet. Reused across the speaking page's hero, clips, and
// testimonials sections (docs/06-speaking-page-copy.md).
interface Props {
  label: string;
  aspect?: string;
}
const { label, aspect = "16/9" } = Astro.props;
---

<div class="media-placeholder" style={`aspect-ratio:${aspect}`}>
  <svg class="placeholder-icon" width="26" height="26" viewBox="0 0 24 24" fill="none">
    <path
      d="M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="square"
    />
  </svg>
  <span class="placeholder-label">{label}</span>
</div>

<style>
  .media-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    background: var(--color-paper);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-card);
    color: var(--color-ink-soft);
  }
  .placeholder-icon {
    opacity: 0.6;
  }
  .placeholder-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    padding: 0 var(--space-3);
  }
</style>
