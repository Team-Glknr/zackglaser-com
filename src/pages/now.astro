---
// Structure/tokens ported from docs/design-system/Now Page.dc.html.
import Layout from "../layouts/Layout.astro";

const entries = [
  {
    pillarId: "running",
    label: "training for",
    value: "local 5Ks",
    detail: "Racing local 5Ks this season, and coaching a high school cross country team on the side.",
  },
  {
    pillarId: "workshop",
    label: "building",
    value: "a garden-tracking app",
    detail: "A small personal project, separate from this site's own build log.",
  },
  {
    pillarId: "legal-tech",
    label: "thinking about",
    value: "LLMs as the new daily interface for lawyers",
    detail: "CoWork, ChatGPT Work, and the rest — probably where daily practice work is headed next.",
  },
  {
    pillarId: "field-notes",
    label: "reading",
    value: "Pause, by Shawn Vanderhoven",
    detail: "Prepping for a podcast interview with the author.",
  },
];

const lastUpdated = new Date().toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
---

<Layout title="Now — zackglaser.com" description="What Zack is building, training for, and reading right now.">
  <div class="now-container">
    <div class="now-header">
      <div class="eyebrow">/now</div>
      <h1>What I'm up to, right now.</h1>
      <p class="sub">
        A page for the curious, not a deliverable. Updated whenever something changes — last touched {lastUpdated}.
        If you've never heard of a <a href="https://nownownow.com/about" class="inline-link">/now page</a>, it's a
        small convention: one honest snapshot instead of a stale "about" bio.
      </p>
    </div>

    <div class="entries-list">
      {
        entries.map((e) => (
          <div class="entry-row">
            <div class="entry-label-col">
              <span class="entry-dot" style={`background:var(--pillar-${e.pillarId})`} />
              <span class="entry-label">{e.label}</span>
            </div>
            <div class="entry-body-col">
              <div class="entry-value">{e.value}</div>
              <div class="entry-detail">{e.detail}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .now-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .now-header {
    margin-bottom: var(--space-8);
    max-width: 620px;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-3);
  }
  h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 34px;
    color: var(--color-ink);
    margin: 0 0 14px;
  }
  .sub {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0;
  }
  .inline-link {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  .inline-link:hover {
    border-bottom-color: var(--color-ink);
  }

  .entries-list {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-8);
  }
  .entry-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
    border-bottom: 1px solid var(--color-line);
  }
  .entry-label-col {
    display: flex;
    align-items: center;
  }
  .entry-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: var(--space-2);
    flex-shrink: 0;
  }
  .entry-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .entry-body-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .entry-value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .entry-detail {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--color-ink-soft);
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    h1 {
      font-size: 26px;
    }
    .entry-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
