---
// One chapter of a build-log project: its own rollup (stats + recap prose,
// authored in the chapter's body) plus a plain list of the entries it covers.
// Static page per chapter, not the swipeable-carousel mockup — this is a
// mostly-static Astro site and a plain prev/next fits it better.
import { getCollection, render } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import NewsletterCard from "../../../../components/NewsletterCard.astro";
import { chapterRange, entryNumber, getChapterEntries, getProjectChapters, getProjectEntries } from "../../../../lib/buildLog";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  const projects = await getCollection("projects");

  return Promise.all(
    chapters.map(async (chapter) => {
      const project = projects.find((p) => p.data.series === chapter.data.project)!;
      const siblings = await getProjectChapters(chapter.data.project);
      const idx = siblings.findIndex((c) => c.id === chapter.id);
      return {
        params: { series: chapter.data.project, chapter: String(chapter.data.order) },
        props: {
          chapter,
          project,
          prevChapter: idx > 0 ? siblings[idx - 1] : null,
          nextChapter: idx < siblings.length - 1 ? siblings[idx + 1] : null,
        },
      };
    })
  );
}

const { chapter, project, prevChapter, nextChapter } = Astro.props;
const { Content } = await render(chapter);

const projectEntries = await getProjectEntries(project.data.series);
const entries = getChapterEntries(chapter, projectEntries).filter((e) => e.data.status === "published");
---

<Layout
  title={`${chapter.data.title} — ${project.data.title} — zackglaser.com`}
  image={`/og/workshop-chapters/${project.data.series}/${chapter.data.order}.png`}
>
  <div class="chapter-container" style="--accent:var(--pillar-workshop)">
    <a href={`/workshop/${project.data.series}`} class="breadcrumb">← {project.data.title} — project view</a>

    <div class="article-header">
      <div class="meta-row">
        <span class="pillar-tag">workshop</span>
        <span class="format-pill">chapter · entries {chapterRange(chapter)}</span>
      </div>
      <h1 class="h1">{chapter.data.title}</h1>
    </div>

    <div class="stats-row">
      <div class="stat-box">
        <div class="stat-label">cost</div>
        <div class="stat-val">{chapter.data.cost}</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">time</div>
        <div class="stat-val">—</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">entries</div>
        <div class="stat-val">{entries.length}</div>
      </div>
    </div>

    <article class="article-body">
      <Content />
    </article>

    <div class="entries-label">the entries — {chapterRange(chapter)}</div>
    <div class="entries-list">
      {
        entries.map((post) => (
          <a href={`/${post.id}`} class="entry-row">
            <div class="entry-row-left">
              <span class="entry-no">{String(entryNumber(post)).padStart(3, "0")}</span>
              <span class="format-pill">{post.data.format}</span>
              <span class="entry-title">{post.data.title}</span>
            </div>
            <span class="entry-date">
              {post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}
            </span>
          </a>
        ))
      }
    </div>

    <div class="chapter-nav-row">
      {prevChapter ? (
        <a href={`/workshop/${project.data.series}/chapters/${prevChapter.data.order}`} class="chapter-nav-card">
          <img
            class="chapter-nav-img"
            src={`/og/workshop-chapters/${project.data.series}/${prevChapter.data.order}.png`}
            alt=""
            loading="lazy"
          />
          <div class="chapter-nav-body">
            <div class="chapter-nav-label">← previous chapter</div>
            <div class="chapter-nav-title">{prevChapter.data.title}</div>
          </div>
        </a>
      ) : (
        <div />
      )}
      {nextChapter ? (
        <a
          href={`/workshop/${project.data.series}/chapters/${nextChapter.data.order}`}
          class="chapter-nav-card chapter-nav-card-right"
        >
          <img
            class="chapter-nav-img"
            src={`/og/workshop-chapters/${project.data.series}/${nextChapter.data.order}.png`}
            alt=""
            loading="lazy"
          />
          <div class="chapter-nav-body">
            <div class="chapter-nav-label">next chapter →</div>
            <div class="chapter-nav-title">{nextChapter.data.title}</div>
          </div>
        </a>
      ) : (
        <div />
      )}
    </div>

    <NewsletterCard eyebrow="get workshop in your inbox" tag="workshop" />
  </div>
</Layout>

<style>
  .chapter-container {
    max-width: 760px;
    margin: 0 auto;
  }

  .breadcrumb {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-soft);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }
  .breadcrumb:hover {
    color: var(--color-ink);
  }

  .article-header {
    margin-bottom: var(--space-5);
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .pillar-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .format-pill {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 1px 9px;
  }
  .h1 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 32px;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0;
  }

  .stats-row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .stat-box {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 10px 16px;
    min-width: 100px;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 4px;
  }
  .stat-val {
    font-family: var(--font-serif);
    font-size: 16px;
    color: var(--color-ink);
  }

  .article-body {
    margin-bottom: var(--space-6);
  }
  .article-body :global(p) {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.75;
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
  }
  .article-body :global(h2) {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ink-soft);
    margin: var(--space-6) 0 var(--space-3);
  }
  .article-body :global(ul) {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
    padding-left: 1.3em;
  }

  .entries-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }
  .entries-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-7);
  }
  .entry-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-raised);
  }
  .entry-row:last-child {
    border-bottom: none;
  }
  .entry-row:hover {
    background: var(--color-paper);
  }
  .entry-row-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .entry-no {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    flex-shrink: 0;
    width: 28px;
  }
  .format-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 2px 9px;
    flex-shrink: 0;
  }
  .entry-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 16px;
    color: var(--color-ink);
  }
  .entry-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .chapter-nav-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .chapter-nav-card {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
  }
  .chapter-nav-card-right {
    text-align: right;
    align-items: flex-end;
  }
  .chapter-nav-img {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    display: block;
  }
  .chapter-nav-body {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .chapter-nav-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
  }
  .chapter-nav-title {
    font-family: var(--font-serif);
    font-size: 15px;
    color: var(--color-ink);
    line-height: 1.3;
  }

  @media (max-width: 560px) {
    .h1 {
      font-size: 26px;
    }
    .chapter-nav-row {
      grid-template-columns: 1fr;
    }
  }
</style>
