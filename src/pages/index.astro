---
// Structure/tokens ported from docs/design-system/Hub.dc.html — "plain"
// hero variant (the mockup's default). The other three variants (cta,
// wizard, latest-project) need real subscriber counts or published posts
// to not feel fake, so they're deferred until that content exists.
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import NewsletterCard from "../components/NewsletterCard.astro";
import EmptyState from "../components/EmptyState.astro";
import { pillars } from "../lib/pillars";
import { postMetaCrossPillar } from "../lib/postMeta";

const allPosts = await getCollection("posts", ({ data }) => data.status === "published");
const latestPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Layout title="zackglaser.com">
  <div class="hero">
    <p class="hero-text">
      I'm Zack — a legal tech advisor by day, a runner and tinkerer the rest of the time. This site is where I take
      things apart: software, training plans, workbenches — to see how they work, and show you the pieces.
    </p>
    <a href="/now" class="now-link">what I'm up to right now →</a>
  </div>

  <div class="doors-grid">
    {
      pillars.map((p) => (
        <a href={p.href} class="door-card" style={`--accent:var(--pillar-${p.id})`}>
          <div class="door-label">{p.label}</div>
          <div class="door-desc">{p.doorDesc}</div>
          <div class="door-enter">enter →</div>
        </a>
      ))
    }
  </div>

  <div class="section-label">latest</div>
  {
    latestPosts.length > 0 ? (
      <div class="latest-grid">
        {latestPosts.map((post) => {
          const pillarAccent = `var(--pillar-${post.data.pillar})`;
          return (
            <div class="post-card" style={`--accent:${pillarAccent}`}>
              <div class="post-tag">{pillars.find((p) => p.id === post.data.pillar)?.label}</div>
              <div class="post-title">{post.data.title}</div>
              <div class="post-meta">{postMetaCrossPillar(post)}</div>
              <a href={`/${post.id}`} class="post-link">
                read the teardown →
              </a>
            </div>
          );
        })}
      </div>
    ) : (
      <EmptyState message="The first teardown is still on the bench. Subscribe below and it'll land in your inbox the day it's published." />
    )
  }

  <NewsletterCard />
</Layout>

<style>
  .hero {
    max-width: 680px;
    margin-bottom: var(--space-8);
  }
  .hero-text {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 26px;
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0 0 var(--space-5);
  }
  .now-link {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-ink-soft);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .now-link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .doors-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .door-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
  }
  .door-card:hover {
    border-color: var(--accent);
  }
  .door-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 20px;
  }
  .door-desc {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-ink-soft);
    line-height: 1.5;
    flex: 1;
  }
  .door-enter {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .post-card {
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .post-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: 20px;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
  }
  .post-link {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .post-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .doors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .hero-text {
      font-size: 22px;
    }
    .doors-grid,
    .latest-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
