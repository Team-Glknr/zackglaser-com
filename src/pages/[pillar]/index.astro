---
// Structure/tokens ported from docs/design-system/Pillar Page.dc.html.
// Format filter chips are inert in the mockup itself (no onClick wired
// up there either) — real filtering is deferred until there's enough
// published content per pillar to make it worth building.
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NewsletterCard from "../../components/NewsletterCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { pillars } from "../../lib/pillars";
import { postMetaWithinPillar } from "../../lib/postMeta";

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { pillar: p.id }, props: { pillar: p } }));
}

const { pillar } = Astro.props;

const posts = (
  await getCollection("posts", ({ data }) => data.status === "published" && data.pillar === pillar.id)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const FORMATS = ["teardown", "log", "take"];
---

<Layout title={`${pillar.label} — zackglaser.com`} description={pillar.doorDesc}>
  <div class="pillar-header" style={`--accent:var(--pillar-${pillar.id})`}>
    <h1 class="pillar-label">{pillar.label}</h1>
    <p class="pillar-dek">{pillar.doorDesc}</p>
  </div>

  <div class="filter-row">
    <span class="filter-active">all</span>
    {FORMATS.map((f) => <span class="filter-chip">{f}</span>)}
  </div>

  {
    posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => (
          <a href={`/${post.id}`} class="post-row">
            <div class="post-row-left">
              <span class="format-pill">{post.data.format}</span>
              <div class="post-title">{post.data.title}</div>
            </div>
            <div class="post-meta">{postMetaWithinPillar(post)}</div>
          </a>
        ))}
      </div>
    ) : (
      <EmptyState message="This pillar's first teardown is still on the bench. Subscribe below and it'll land in your inbox the day it's published." />
    )
  }

  <NewsletterCard eyebrow={`get ${pillar.label} in your inbox`} />
</Layout>

<style>
  .pillar-header {
    margin-bottom: var(--space-6);
    max-width: 640px;
  }
  .pillar-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 36px;
    color: var(--color-ink);
    margin: 0 0 10px;
    border-bottom: 3px solid var(--accent);
    display: inline-block;
    padding-bottom: 6px;
  }
  .pillar-dek {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--color-ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .filter-active {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-paper);
    background: var(--color-ink);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
  }
  .filter-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 6px 14px;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-6);
  }
  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-raised);
  }
  .post-row:last-child {
    border-bottom: none;
  }
  .post-row:hover {
    background: var(--color-paper);
  }
  .post-row-left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }
  .format-pill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-soft);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 2px 9px;
    flex-shrink: 0;
  }
  .post-title {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--color-ink);
    line-height: 1.3;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-ink-soft);
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .pillar-label {
      font-size: 28px;
    }
    .post-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
